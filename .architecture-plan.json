  "lmax_disruptor_integration": {
    "summary": "LMAX Disruptor RingBuffer replaces ExecutorService for SIP message dispatching. Virtual Threads for per-message processing.",
    "current_flow": [
      "1. JAIN SIP Listener \u2192 SipApplicationDispatcherImpl.processRequest(RequestEvent)",
      "2. Creates SipServletRequestImpl, checks congestion, strips route headers",
      "3. MessageDispatcherFactory.getRequestDispatcher() \u2192 InitialRequestDispatcher / SubsequentRequestDispatcher / CancelRequestDispatcher",
      "4. Dispatcher.dispatchMessage() locates SipSession, creates DispatchTask(Runnable)",
      "5. sipContext.enterSipApp() acquires concurrency semaphore",
      "6. getConcurrencyModelExecutorService().execute(dispatchTask) \u2192 asynchronousExecutor (ThreadPoolExecutor + LinkedBlockingQueue)",
      "7. DispatchTask.run() \u2192 dispatchAndHandleExceptions() \u2192 dispatch() \u2192 callServlet() \u2192 servlet.service(request,null)",
      "8. sipContext.exitSipApp() releases semaphore + triggers HA replication"
    ],
    "bottlenecks": [
      "LinkedBlockingQueue head-of-line blocking under load",
      "ThreadPoolExecutor contention at 64 max threads",
      "No message prioritization (CANCEL competes with INVITE for executor slots)",
      "bypassRequestExecutor=true skips executor entirely (already default) \u2014 direct-thread processing"
    ],
    "target_architecture": {
      "ringbuffer": {
        "class": "com.lmax.disruptor.dsl.Disruptor<SipMessageEvent>",
        "ring_size": 32768,
        "producer_type": "SINGLE",
        "wait_strategy": "BusySpinWaitStrategy",
        "thread_factory": "Thread.ofVirtual().factory()"
      },
      "event_class": {
        "name": "SipMessageEvent",
        "fields": [
          "MessageType type: INITIAL_REQUEST | SUBSEQUENT_REQUEST | CANCEL_REQUEST | RESPONSE | DIALOG_TIMEOUT | TRANSACTION_TIMEOUT",
          "SipServletMessageImpl message",
          "SipProvider sipProvider",
          "long sequence",
          "long publishTimestamp"
        ]
      },
      "handlers": [
