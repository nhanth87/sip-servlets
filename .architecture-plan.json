  "virtual_threads_processing": {
    "summary": "Java 25 Virtual Threads replace ThreadPoolExecutor for SIP message processing \u2014 one VT per message, scalable to millions of concurrent calls.",
    "key_decisions": [
      {
        "decision": "VT per message, not VT pool",
        "rationale": "VTs are designed for one-task-per-thread. ~200 bytes heap each. No pooling needed."
      },
      {
        "decision": "VT factory for Disruptor event handlers",
        "rationale": "3 handler VTs constantly reading from RingBuffer. Each message dispatch is also a VT."
      },
      {
        "decision": "VT factory for HashedWheelTimer",
        "rationale": "Timer callbacks (ServletTimerImpl.run()) execute on VT \u2014 no thread pool starvation."
      },
      {
        "decision": "ScopedValue replaces ThreadLocal",
        "rationale": "For SipApplicationSession/SipSession/SipContext bindings throughout call chain."
      }
    ],
    "vt_usage_locations": [
      {
        "location": "Disruptor EventHandlers",
        "factory": "Thread.ofVirtual().name('sip-disruptor-', 0).factory()"
      },
      {
        "location": "Timer callbacks (ServletTimerImpl.run)",
        "factory": "Thread.ofVirtual().name('sip-timer-', 0).factory()"
      },
      {
        "location": "Per-message servlet.service() call",
        "code": "Thread.startVirtualThread(() -> callServlet(request))"
      },
      {
        "location": "Transaction timeout handling",
        "code": "Publish to Disruptor with VT processing"
      }
    ],
    "scoped_values_migration": {
      "replaces": [
        "SipApplicationSessionCreationThreadLocal",
        "SipContext.enterSipContext()/exitSipContext() ClassLoader switching"
      ],
      "new_pattern": "ScopedValue.where(SIP_CONTEXT_KEY, sipContext).run(() -> { ... })"
    },
    "risk_vt_pin": "Convert synchronized blocks in SipContext semaphore path to ReentrantLock to avoid VT pinning."
  },
