  "risk_assessment": {
    "high": [
      {
        "item": "Concurrency control semaphore + Virtual Threads \u2014 VTs pin on synchronized",
        "mitigation": "Convert all synchronized blocks in hot path (SipContext, session state) to ReentrantLock"
      },
      {
        "item": "JAIN SIP (NIST) thread model \u2014 may assume platform threads",
        "mitigation": "Test extensively for VT compatibility in timer and transport layers"
      }
    ],
    "medium": [
      {
        "item": "BusySpinWaitStrategy CPU usage",
        "mitigation": "Make wait strategy configurable \u2014 YieldingWaitStrategy or SleepingWaitStrategy for non-latency-critical deployments"
      },
      {
        "item": "HashedWheelTimer single-thread \u2014 callbacks fire on wheel thread",
        "mitigation": "Never block in timer callback. Wrap in Thread.startVirtualThread()"
      },
      {
        "item": "Log4j \u2192 SLF4J migration needed",
        "mitigation": "sip-servlets uses org.apache.log4j.Logger throughout. Migrate to SLF4J for Quarkus/Spring Boot compat."
      }
    ],
    "low": [
      {
        "item": "Bypass executors already default \u2014 smooth transition",
        "mitigation": "bypassRequestExecutor=true is already default. Disruptor just adds ring buffer before the existing direct path."
      }
    ]
  },
