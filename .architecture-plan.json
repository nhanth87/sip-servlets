          "routes_to": "ResponseDispatcher.dispatchMessage()",
          "vt_exec": "Thread.startVirtualThread(() -> legacyDispatch())"
        }
      ],
      "pipeline": "disruptor.handleEventsWith(initHandler, subCancelHandler).then(responseHandler)",
      "integration_points": [
